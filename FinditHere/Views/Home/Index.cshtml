@model List<FinditHere.Models.Pelicula>

@{
    ViewData["Title"] = "Home Page";
}

<div class="peliculas">
    @foreach (var p in Model)
    {
        <div class="tarjeta">
            <img src="https://image.tmdb.org/t/p/w500@(p.RutaPoster)" alt="@p.Titulo" />
             <h3>@p.Titulo</h3>
            <p>@p.Calificacion.ToString("0.0")</p>
        </div>
    }
</div>